# Env vars for the local Supabase stack. Referenced from config.toml via env(...).
# Paths are relative to this directory (packages/wallet-sdk/db/supabase), where config.toml lives.

# Self-signed certificate used to serve the local Supabase API over HTTPS.
# The certificate itself is generated by devenv (see `generate-ssl-cert`).
SELF_SIGNED_CERT_PATH='../../../../certs/localhost-cert.pem'
SELF_SIGNED_CERT_KEY_PATH='../../../../certs/localhost-key.pem'
